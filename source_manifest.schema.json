{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sov.source_manifest.v0.1",
  "title": "Sovereign source manifest v0.1",
  "type": "object",
  "required": ["schema", "schema_version", "manifest_id", "source_kind", "provider", "retrieval", "access", "artifacts", "limitations"],
  "properties": {
    "schema": {"const": "sov.source_manifest"},
    "schema_version": {"const": "0.1.0"},
    "manifest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "source_kind": {"enum": ["repository", "dataset", "literature", "benchmark", "artifact", "api_response"]},
    "provider": {"type": "object", "required": ["name", "canonical_url"], "properties": {"name": {"type": "string", "minLength": 1}, "canonical_url": {"type": "string", "format": "uri"}}, "additionalProperties": true},
    "retrieval": {"type": "object", "required": ["retrieved_at_utc", "locator", "version_or_revision"], "properties": {"retrieved_at_utc": {"type": "string", "format": "date-time"}, "locator": {"type": "string", "minLength": 1}, "version_or_revision": {"type": "string", "minLength": 1}, "query": {"type": "object"}}, "additionalProperties": true},
    "access": {"type": "object", "required": ["classification", "license_or_terms"], "properties": {"classification": {"enum": ["public", "restricted", "unknown"]}, "license_or_terms": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "locator", "sha256"], "properties": {"role": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": true}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
